---
layout: null
---
[
  {% assign first = true %}
  {% for post in site.posts %}
  {% unless first %},{% endunless %}{% assign first = false %}
  {
    "type": "post",
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
    "tags": {{ post.tags | jsonify }},
    "subtitle": {{ post.subtitle | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | strip_newlines | truncate: 200 | jsonify }},
    "content": {{ post.content | strip_html | strip_newlines | jsonify }}
  }
  {% endfor %}
  {% for note in site.notes %}
  {% unless first %},{% endunless %}{% assign first = false %}
  {
    "type": "note",
    "title": {{ note.title | jsonify }},
    "url": {{ note.url | relative_url | jsonify }},
    "date": {{ note.date | date: "%Y-%m-%d" | jsonify }},
    "category": {{ note.category | jsonify }},
    "tags": {{ note.tags | jsonify }},
    "content": {{ note.content | strip_html | strip_newlines | jsonify }}
  }
  {% endfor %}
]
